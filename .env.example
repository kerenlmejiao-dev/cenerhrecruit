# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" real NUNCA debe subirse a git (ya está en .gitignore).

# Base de datos local (SQLite - no sale de esta PC)
DATABASE_URL=sqlite:///./cenerh_recruit.db

# Host/puerto de la API. 127.0.0.1 = solo accesible desde esta PC.
# Si expones la API por un túnel (Cloudflare Tunnel, Tailscale, etc.),
# deja esto en 127.0.0.1 y que sea el túnel el que reciba tráfico externo.
API_HOST=127.0.0.1
API_PORT=8000

# Orígenes permitidos por CORS (separados por coma).
# Agrega aquí la URL pública de tu frontend cuando la tengas.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API key de administrador: protege endpoints administrativos/masivos.
# Genera una propia (no uses un valor de ejemplo) y guárdala en un
# gestor de contraseñas. Se envía en el header "X-Admin-Key".
ADMIN_API_KEY=

# Clave para firmar los JWT de reclutador/empresa. Genera una propia
# (nunca uses un valor de ejemplo) y consérvala en secreto.
SECRET_KEY=
JWT_EXPIRE_MINUTES=600

# Código de invitación para que un reclutador pueda autorregistrarse en
# /registro (POST /api/auth/registro). Compártelo solo con quien deba poder
# crear su propia cuenta de reclutador. Vacío = autorregistro deshabilitado.
REGISTRO_RECLUTADOR_CODIGO=

# API key de Anthropic (Claude) para puntuar las respuestas de los
# assessment centers contra su rúbrica. Sin esta clave, esos tests
# quedan deshabilitados.
ANTHROPIC_API_KEY=

# dLocal (suscripciones de reclutadores + desbloqueo de candidatos).
# Usa tus credenciales de SANDBOX mientras desarrollas.
# Sin estas claves, los endpoints de pago quedan deshabilitados.
DLOCAL_X_LOGIN=
DLOCAL_X_TRANS_KEY=
DLOCAL_SECRET_KEY=
DLOCAL_API_BASE_URL=https://api.sandbox.dlocal.com
# URL pública donde dLocal puede enviar notificaciones (webhook). En localhost
# puro déjalo vacío - el sistema verifica el estado manualmente como respaldo.
DLOCAL_NOTIFICATION_URL=

# URL del frontend, para la redirección de vuelta tras pagar en dLocal
FRONTEND_URL=http://localhost:5173

# Email (para producción; en modo mock no se usa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=

# CRM (opcional)
HUBSPOT_API_KEY=
PIPEDRIVE_API_TOKEN=

# App
ENV=development
DEBUG=True
